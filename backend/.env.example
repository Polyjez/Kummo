# Copy to backend/.env and fill in. The repo-root .env.local / .env.prod files carry
# the same keys and are what start-kummo.sh reads.

# --- Supabase Auth (GoTrue) ---
# Identity only. Application data no longer goes through PostgREST.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_API_KEY=<anon key — public by design>

# --- Database ---
# Runtime connection, as the DML-only kummo_app role.
DATABASE_URL=postgresql+asyncpg://kummo_app:<password>@127.0.0.1:54322/postgres
# DDL connection, as kummo_migrator. Alembic only.
# Percent-encode reserved characters in the password (@ -> %40).
MIGRATION_DATABASE_URL=postgresql+asyncpg://kummo_migrator:<password>@127.0.0.1:54322/postgres
